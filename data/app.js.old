document.addEventListener("DOMContentLoaded", () => {
    const tbody = document.getElementById('tabla-body');
    const filtroFecha = document.getElementById('filtro-fecha');
    const filtroEstado = document.getElementById('filtro-estado');
    const btnLimpiar = document.getElementById('btn-limpiar');

    let todosLosDatos = []; // Array global para guardar todos los registros leídos

    // Función para leer y formatear los datos del TXT
    async function cargarDatos() {
        try {
            const respuesta = await fetch('datos.txt');
            if (!respuesta.ok) throw new Error('No se pudo encontrar datos.txt');
            
            const texto = await respuesta.text();
            const lineas = texto.split('\n');
            
            todosLosDatos = []; // Limpiamos el array antes de llenarlo

            lineas.forEach(linea => {
                if (linea.trim() === '') return;
                
                const partes = linea.split(';');
                if (partes.length >= 3) {
                    const fechaHora = partes[0].trim().split(' '); 
                    const fecha = fechaHora[0]; // Formato del TXT (DD-MM-YYYY)
                    const hora = fechaHora[1];
                    const temp = partes[1].trim() + '°C';
                    
                    let estadoRaw = partes[2].trim().toLowerCase();
                    const estado = estadoRaw.charAt(0).toUpperCase() + estadoRaw.slice(1);
                    
                    // Guardamos el objeto en nuestra lista
                    todosLosDatos.push({ fecha, hora, temp, estado });
                }
            });

            // Una vez cargados, pintamos la tabla completa
            renderizarTabla(todosLosDatos);

        } catch (error) {
            console.error("Error:", error);
            tbody.innerHTML = `<tr><td colspan="4" class="py-4 text-center text-red-400 font-semibold">Error al cargar datos.txt</td></tr>`;
        }
    }

    // Función para pintar la tabla basándose en un array de datos
    function renderizarTabla(datos) {
        tbody.innerHTML = ''; // Limpiamos el HTML actual
        
        if (datos.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-gray-500 font-semibold">No hay registros que coincidan con los filtros</td></tr>`;
            return;
        }

        datos.forEach(dato => {
            const tr = document.createElement('tr');
            
            let estiloEstado = '';
            if (dato.estado === 'Normal') {
                estiloEstado = 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/50';
            } else if (dato.estado === 'Advertencia') {
                estiloEstado = 'bg-yellow-500/20 text-yellow-400 border border-yellow-500/50';
            } else if (dato.estado === 'Alerta') {
                estiloEstado = 'bg-red-500/20 text-red-400 border border-red-500/50 animate-pulse shadow-[0_0_10px_rgba(239,68,68,0.5)]';
            }

            tr.innerHTML = `
                <td class="py-4 px-6 text-center text-gray-300 whitespace-nowrap">${dato.fecha}</td>
                <td class="py-4 px-6 text-center text-gray-300 font-mono">${dato.hora}</td>
                <td class="py-4 px-6 text-center text-gray-100 font-semibold text-base">${dato.temp}</td>
                <td class="py-4 px-6 text-center">
                    <span class="py-1 px-3 rounded-full text-xs font-semibold tracking-wide inline-block ${estiloEstado}">
                        ${dato.estado}
                    </span>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    // Función que evalúa los filtros seleccionados
    function aplicarFiltros() {
        let datosFiltrados = todosLosDatos;

        // 1. Filtrar por Estado
        const estadoSeleccionado = filtroEstado.value;
        if (estadoSeleccionado !== 'Todos') {
            datosFiltrados = datosFiltrados.filter(dato => dato.estado === estadoSeleccionado);
        }

        // 2. Filtrar por Fecha
        const fechaSeleccionada = filtroFecha.value; // Formato nativo: YYYY-MM-DD
        if (fechaSeleccionada) {
            // El input date arroja AAAA-MM-DD, pero tu TXT tiene DD-MM-AAAA.
            // Hay que transformar el valor del input para que coincidan.
            const [anio, mes, dia] = fechaSeleccionada.split('-');
            const fechaFormateada = `${dia}-${mes}-${anio}`;
            
            datosFiltrados = datosFiltrados.filter(dato => dato.fecha === fechaFormateada);
        }

        // Pintamos la tabla con los datos resultantes
        renderizarTabla(datosFiltrados);
    }

    // Eventos: Ejecutar filtros cuando el usuario interactúa
    filtroEstado.addEventListener('change', aplicarFiltros);
    filtroFecha.addEventListener('change', aplicarFiltros);
    
    // Evento: Botón para reiniciar todo
    btnLimpiar.addEventListener('click', () => {
        filtroEstado.value = 'Todos';
        filtroFecha.value = '';
        renderizarTabla(todosLosDatos);
    });

    // Iniciar
    cargarDatos();
});